<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of ModLib and Taoist code that does not need the running game (pure helpers, formulas, configs).
    Shared setup (framework, MSTest, game assemblies, TestSetup/Check, the ModLib tests): GuiGuBaHuang-ModLib\tests\UnitTests.props.
    Here: the references to the build output of this repository and the Taoist tests (Taoist\, KnownIssues.cs).
    Build ModLib and Taoist first (Release); run: scripts\run-unittests.ps1
  -->

  <PropertyGroup>
    <!-- this repository builds ModLib.dll (3385996759): its tests run here -->
    <IncludeModLibTests>true</IncludeModLibTests>
  </PropertyGroup>

  <Import Project="..\..\GuiGuBaHuang-ModLib\tests\UnitTests.props" />

  <ItemGroup>
    <!-- code under test (build output of the mods) -->
    <Reference Include="ModLib">
      <HintPath>$(RepoRoot)\3385996759\debug\Mod_flQrxq\ModCode\dll\ModLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MOD_nE7UL2">
      <HintPath>$(RepoRoot)\3161035078\debug\Mod_nE7UL2\ModCode\dll\MOD_nE7UL2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RepoRoot)\3385996759\debug\Mod_flQrxq\ModCode\dll\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
